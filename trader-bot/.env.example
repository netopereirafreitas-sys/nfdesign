# Copy this file to .env and fill in your values.
# NEVER commit your real .env file (it is already in .gitignore).

# "simulated" (default, no real orders, runs anywhere) or "real"
# (sends real orders via Profit Pro / XP, Windows only).
MODE=simulated

# B3 futures ticker. WIN/WDO contracts roll monthly/quarterly - update
# this each expiration (e.g. WINZ25, WINF26). Check the current front
# contract in Profit Pro before running in real mode.
TICKER=WINFUT

# Strategy parameters (moving average crossover)
MA_FAST=9
MA_SLOW=21

# Order size, in contracts
ORDER_QTY=1

# Risk limits
MAX_POSITION=1
MAX_DAILY_LOSS=-500
STOP_LOSS_POINTS=500
TAKE_PROFIT_POINTS=1000

# --- Only required when MODE=real ---
# Path to the ProfitDLL64.dll provided by Nelogica/XP.
PROFIT_DLL_PATH=ProfitDLL64.dll
# Activation key issued by Nelogica/XP for API access.
PROFIT_ACTIVATION_KEY=
# Your XP / Profit Pro login and password.
PROFIT_LOGIN=
PROFIT_PASSWORD=
